############################################
# 1) Frontend build (Angular)
############################################
ARG NODE_IMAGE=cgr.dev/chainguard/node:latest-dev
ARG RUST_IMAGE=cgr.dev/chainguard/rust:latest-dev

FROM ${NODE_IMAGE} AS fe

USER root

WORKDIR /builder

COPY package*.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY angular.json ./
COPY tsconfig*.json ./
COPY proxy.conf.js ./
COPY src ./src
RUN npx ng build --base-href=./


############################################
# 2) Backend build (Rust API — musl/static)
############################################
FROM ${RUST_IMAGE} AS be

USER root

WORKDIR /builder

RUN apk add --no-cache \
    build-base \
    cmake \
    perl \
    pkgconfig \
    linux-headers

COPY api/Cargo.toml api/Cargo.lock ./api/
WORKDIR /builder/api

RUN mkdir -p src && echo "fn main() {}" > src/main.rs
RUN cargo build --release

COPY api/src ./src
RUN touch src/main.rs && cargo build --release
RUN test -f target/release/gcd_api


############################################
# 3) Runtime image (Alpine + debug tools, non-root, OpenShift-friendly)
############################################
FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

RUN apk upgrade --no-cache \
    && apk add --no-cache \
        ca-certificates-bundle \
        tzdata \
        bash \
        curl \
        wget \
        procps \
        net-tools \
        strace \
        lsof \
        bind-tools

WORKDIR /app

ARG VERSION_ARG=0.0.4
ENV VERSION=${VERSION_ARG}
ENV RUST_LOG=debug

# Copy frontend and backend artifacts
COPY --from=fe /builder/dist/gitlab-ci-dashboard/browser ./spa
COPY --from=be /builder/api/target/release/gcd_api ./gcd_api

# Fix permissions
RUN chown -R 65532:65532 /app

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/app/gcd_api"]
