# Debug runtime: production artifacts plus a small Wolfi shell environment.
ARG PRODUCTION_IMAGE=mohankrishna999/gitlab-ci-dashboard:v16
ARG DEBUG_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:360896efb0753a5701c48f860e17130c205eae5a264797aa3e7ea126ee2923a7
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard
ARG APK_DOWNLOAD_IMAGE=cgr.dev/chainguard/python:latest-dev@sha256:c179c7d8e23caed59a51ff74d4742f8f8d3f16af4c33c40acaf8d3ee07234592

FROM ${PRODUCTION_IMAGE} AS production
FROM ${DEBUG_IMAGE} AS debug-base

# Download with GNU wget, retaining signed APK verification during installation.
FROM ${APK_DOWNLOAD_IMAGE} AS debug-packages
ARG APK_REPOSITORY
USER root
COPY --from=debug-base /usr/lib/apk/db/installed /tmp/apk-root/usr/lib/apk/db/installed
COPY --from=debug-base /etc/apk/world /tmp/apk-root/etc/apk/world
COPY --from=debug-base /etc/apk/keys/ /etc/apk/keys/
COPY container/prepare-apk-repository.sh /usr/local/bin/prepare-apk-repository.sh
RUN --mount=type=cache,id=gitlab-dashboard-release-apks,target=/tmp/apks,sharing=locked \
    sh /usr/local/bin/prepare-apk-repository.sh "$APK_REPOSITORY" /tmp/apk-root bash ca-certificates-bundle tzdata

FROM debug-base AS debug
ARG APK_REPOSITORY

USER root
WORKDIR /app

RUN --mount=type=bind,from=debug-packages,source=/runtime-repository,target=/runtime-repository \
    printf '%s\n' /runtime-repository > /etc/apk/repositories \
    && apk --no-network --no-progress add --no-cache $(cat /runtime-repository/constraints) \
    && glibc_version="$(awk '/^P:/ { package=$0 } /^V:/ && package == "P:glibc-2.44" { sub(/^V:/, ""); print; exit }' /usr/lib/apk/db/installed)" \
    && test -n "$glibc_version" \
    && glibc_comparison="$(apk version -t "$glibc_version" 2.44-r8)" \
    && test "$glibc_comparison" != '<' \
    && printf '%s\n' "${APK_REPOSITORY}" > /etc/apk/repositories \
    && rm -rf /var/cache/apk/*

ENV VERSION=2.14.1 \
    RUST_LOG=debug

COPY --from=production --chown=65532:65532 /app/spa ./spa
COPY --from=production --chown=65532:65532 /app/gcd_api ./gcd_api

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/gcd_api"]
