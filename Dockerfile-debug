# Debug runtime: production artifacts plus a small Wolfi shell environment.
ARG PRODUCTION_IMAGE=mohankrishna999/gitlab-ci-dashboard:v13
ARG DEBUG_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:bef0f4d47edc72a93d1537eae54eb53db2b2cc352c028128ff0f16c5b5a3c1e4

FROM ${PRODUCTION_IMAGE} AS production
FROM ${DEBUG_IMAGE}

USER root
WORKDIR /app

ENV VERSION=2.14.0 \
    RUST_LOG=debug

COPY --from=production --chown=65532:65532 /app/spa ./spa
COPY --from=production --chown=65532:65532 /app/gcd_api ./gcd_api

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/gcd_api"]
