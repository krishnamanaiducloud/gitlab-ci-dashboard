# Debug runtime: production artifacts plus a small Wolfi shell environment.
ARG PRODUCTION_IMAGE=mohankrishna999/gitlab-ci-dashboard:v14
ARG DEBUG_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:82d42999b1bc4b2aa724b442d300194901e64563efec75b3245e41f4c09fb6d2
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard

FROM ${PRODUCTION_IMAGE} AS production
FROM ${DEBUG_IMAGE}
ARG APK_REPOSITORY

USER root
WORKDIR /app

RUN printf '%s\n' "${APK_REPOSITORY}" > /etc/apk/repositories \
    && apk --timeout 60 upgrade --no-cache \
    && apk --timeout 60 add --no-cache bash ca-certificates-bundle tzdata \
    && rm -rf /var/cache/apk/*

ENV VERSION=2.14.0 \
    RUST_LOG=debug

COPY --from=production --chown=65532:65532 /app/spa ./spa
COPY --from=production --chown=65532:65532 /app/gcd_api ./gcd_api

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/gcd_api"]
