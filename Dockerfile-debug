############################################
# 1) Frontend build (Angular)
############################################
ARG NODE_IMAGE=cgr.dev/chainguard/node:latest-dev@sha256:39708a466eb9e1c4a49abc6931dc8aaf8d3d4565fe6977a53bff0ce1c357a405
ARG RUST_IMAGE=cgr.dev/chainguard/rust:latest-dev@sha256:04ff740c14814353701c10bec4e79bac5d94f10c3e54369e2688bfaf54662092
ARG PRODUCTION_IMAGE=mohankrishna999/gitlab-ci-dashboard:v8

FROM ${PRODUCTION_IMAGE} AS production

FROM ${NODE_IMAGE} AS fe

USER root

WORKDIR /builder

COPY package*.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY angular.json ./
COPY tsconfig*.json ./
COPY proxy.conf.js ./
COPY src ./src
RUN npx ng build --base-href=./


############################################
# 2) Backend build (Rust API — musl/static)
############################################
FROM ${RUST_IMAGE} AS be

USER root

WORKDIR /builder

RUN apk add --no-cache \
    build-base \
    cmake \
    perl \
    pkgconf \
    linux-headers

COPY api/Cargo.toml api/Cargo.lock ./api/
WORKDIR /builder/api

RUN mkdir -p src && echo "fn main() {}" > src/main.rs
RUN cargo build --release

COPY api/src ./src
RUN touch src/main.rs && cargo build --release
RUN test -f target/release/gcd_api


############################################
# 3) Runtime image (Alpine + debug tools, non-root, OpenShift-friendly)
############################################
FROM ${NODE_IMAGE} AS runtime

USER root

WORKDIR /app

ARG VERSION_ARG=0.0.4
ENV VERSION=${VERSION_ARG}
ENV RUST_LOG=debug

# Copy the already tested production artifacts. Unreferenced source-build stages are
# skipped by BuildKit, keeping the debug image byte-for-byte aligned with v8.
COPY --from=production /app/spa ./spa
COPY --from=production /app/gcd_api ./gcd_api

# Fix permissions
RUN chown -R 65532:65532 /app

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/app/gcd_api"]
