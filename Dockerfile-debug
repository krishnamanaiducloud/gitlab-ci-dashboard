# Debug runtime: production artifacts plus a small Wolfi shell environment.
ARG PRODUCTION_IMAGE=mohankrishna999/gitlab-ci-dashboard:v12
ARG DEBUG_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:3754b6da0e1ccdab0fe46abfdd7bbbba994b593c28149f6659fa6597f2261aeb

FROM ${PRODUCTION_IMAGE} AS production
FROM ${DEBUG_IMAGE}

USER root
WORKDIR /app

ENV VERSION=0.0.5 \
    RUST_LOG=debug

COPY --from=production --chown=65532:65532 /app/spa ./spa
COPY --from=production --chown=65532:65532 /app/gcd_api ./gcd_api

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/gcd_api"]
